{
 "file": "cas/hsdPs.py",
 "title": "hsdPs (an HSD ADC/TIM clock phase scan; its plot is drawn by a multiprocessing child, which the walk follows)",
 "web": "/gui/hsdPs",
 "backend": "sim-device:simhsd",
 "walk": {
  "argv": [
   "--base",
   "{pvbase}:HSD:1_PS:A",
   "--xpm",
   "{pvbase}:XPM:7",
   "--range",
   "0",
   "24",
   "8"
  ],
  "devices": [
   {
    "module": "simhsd",
    "args": [
     "-P",
     "{pvbase}:HSD:1_PS:A"
    ]
   },
   {
    "module": "simxpm",
    "args": [
     "-P",
     "{pvbase}",
     "-x",
     "7",
     "--frames",
     "tcp://127.0.0.1:31077",
     "--pull",
     "none"
    ]
   }
  ],
  "pump": 2,
  "timeout": 900,
  "child_timeout": 700,
  "drive": [
   "pump:1",
   "pg-options:720x180"
  ]
 },
 "mapping": {
  "analyze.pp": {
   "web": "[data-parity~=\"analyze.pp\"]",
   "test": "test_gui_hsdPs.py::test_plot_shows_the_pyqt_curves[chromium]"
  },
