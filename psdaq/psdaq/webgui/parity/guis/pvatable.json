{
 "file": "cas/pvatable.py",
 "title": "pvatable (a grid of structure PV fields: --fields down, --bases across; the HSD PVs of cas/hsdpvs.py, served by the simulator simhsd)",
 "web": "/gui/pvatable",
 "backend": "sim-device:simhsd",
 "walk": {
  "argv": [
   "--bases",
   "{pvbase}:HSD:1_DA:A",
   "{pvbase}:HSD:1_DA:B",
   "--fields",
   "MONTIMING.trigcntsum",
   "MONTIMING.timframecnt",
   "MONPGP.txcntsum",
   "MONPGP.rxcnt[2]",
   "MONRAWBUF.freesz"
  ],
  "devices": [
   {
    "module": "simhsd",
    "args": [
     "-P",
     "{pvbase}:HSD:1_DA:A",
     "{pvbase}:HSD:1_DA:B"
    ]
   }
  ],
  "pump": 4,
  "timeout": 90,
  "drive": [
   "pump:1"
  ]
 },
 "mapping": {
  "PvScalarTable.PvField#0": {
   "web": "[data-parity~=\"PvScalarTable.PvField#0\"]",
