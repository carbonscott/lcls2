{
 "file": "cas/hsdpva.py",
 "title": "hsdpva (the HSD monitor: a tab stack per digitizer base; the PVs of cas/hsdpvs.py, served by the simulator simhsd)",
 "web": "/gui/hsdpva",
 "backend": "sim-device:simhsd",
 "walk": {
  "argv": ["{pvbase}:HSD:1_1B:A", "{pvbase}:HSD:1_1B:B"],
  "devices": [{"module": "simhsd", "args": ["-P", "{pvbase}:HSD:1_1B:A", "{pvbase}:HSD:1_1B:B"]}],
  "pump": 4,
  "timeout": 90,
  "drive": ["tabs", "pump:1"]
 },
 "mapping": {}
}
