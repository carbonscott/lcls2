[22.483225, "o", "\u001b[?2004h00:30:12Z root@sdfrome046:w13# "]
[24.323908, "m", "00:30:14Z 3 the runner and the two read-back pollers"]
[24.336516, "o", "cat bin/e2e-at.sh bin/curlpoll.sh bin/pypoll.py"]
[24.643623, "o", "\r\n"]
[24.643658, "o", "\u001b[?2004l\r"]
[24.647356, "o", "#!/bin/bash\r\n"]
[24.647381, "o", "# W13: e2e-at.sh CHECKOUT WORKDIR [e2e args]: `daq_sim e2e` from that checkout of $W13, as the suite's\r\n# fork/webgui-e2e row runs it, with two read-back pollers in the background while it runs:\r\n#   bin/curlpoll.sh  curl of each exporter in WORKDIR/prom (no psdaq code)\r\n#   bin/pypoll.py    the e2e's own scrape call next to the fixed call\r\nC=$1 WD=$2; shift 2\r\ncd $W13/$C && source ./setup_env_daq.sh >/dev/null 2>&1 || exit 1\r\nE=$(python -c 'import psdaq.webgui.e2e as m; print(m.__file__)')\r\n"]
[24.647406, "o", "echo \"checkout $C: $(git log -1 --format='%h %cI') dirty $(git status --porcelain --untracked-files=no | wc -l); e2e.py in use: ${E#$(realpath $W13)/}\"\r\ngrep -n -A1 'in ds.prometheus_targets' $E\r\ncase \" $* \" in *\" --keep-up \"*)   # e2e that brings the DAQ up itself holds it in the foreground; so up first, detached\r\n"]
[24.647429, "o", "  daq_sim up --webgui --detach -w $WD > $WD-up.log 2>&1; echo \"--keep-up: daq_sim up --webgui --detach first: UP_EXIT=$?\";;\r\nesac\r\nbash $W13/bin/curlpoll.sh $WD > $WD-curl.log 2>&1 & P1=$!\r\npython "]
[24.647454, "o", "$W13/bin/pypoll.py $WD/prom > $WD-py.log 2>&1 & P2=$!\r\ndaq_sim e2e -w $WD --events 1000 --browser-python $BP \"$@\" > $WD.log 2>&1; rc=$?\r\nkill $P1 $P2\r\n"]
[24.647476, "o", "grep -E 'e2e: in CONFIGURED|^  [1-7] (PASS|FAIL)|^E2E' $WD.log | cut -c1-300\r\necho \"read-back during the run: $(wc -l < $WD-curl.log) curl readings; last: $(tail -n 1 $WD-curl.log)\"\r\necho \"pypoll last: $(tail -n 1 $WD-py.log)\"\r\necho \"E2E_EXIT=$rc $(date -u +%FT%TZ) log ${WD#$W13/}.log shots ${WD#$W13/}/e2e-shots\"\r\n"]
[24.64774, "o", "#!/bin/bash\r\n# independent read-back: every 0.3 s, curl each exporter listed in $1/prom/*.yaml and print its TEB_WrtCt line\r\nwhile :; do\r\n  for y in \"$1\"/prom/*.yaml; do\r\n    p=$(grep -o \":[0-9]*'\" \"$y\" | tr -d \":'\")\r\n    v=$(curl -s -m 1 \"http://127.0.0.1:$p/metrics\" | grep '^TEB_WrtCt')\r\n    [ -n \"$v\" ] && echo \"$(date -u +%T.%3N) curl 127.0.0.1:$p $v\"\r\n"]
[24.647764, "o", "  done\r\n  sleep 0.3\r\ndone\r\n"]
[24.647943, "o", "\"\"\"Every 0.5 s, for each exporter prometheus_targets() lists: the e2e's own call scrape(<target>, COUNTERS),\r\nwhich since 71895fbda gets a (host, port) tuple as its port, next to scrape(port, COUNTERS, host).\"\"\"\r\n"]
[24.647975, "o", "import datetime, sys, time\r\nfrom psdaq.sim import daq_sim as ds\r\nwhile True:\r\n    for t in ds.prometheus_targets(sys.argv[1]):\r\n        host, port = t if isinstance(t, tuple) else ('127.0.0.1', t)   # tuples since 71895fbda, ints before\r\n        why = []\r\n"]
[24.647998, "o", "        as_e2e = ds.scrape(t, ds.COUNTERS, errors=why)                  # what e2e.py:678-679 passes\r\n        fixed = ds.scrape(port, ds.COUNTERS, host)                       # what the fix passes\r\n        teb = {k.split('{')[0]: int(v) for k, v in fixed.items() if k.startswith('TEB_')}\r\n        if teb:\r\n            got = {k.split('{')[0]: int(v) for k, v in as_e2e.items() if k.startswith('TEB_')}\r\n            print(datetime.datetime.utcnow().strftime('%H:%M:%S.%f')[:12], 'target', t, '| e2e call ->', got, why,\r\n                  '| fixed call ->', "]
[24.648021, "o", "teb, flush=True)\r\n    time.sleep(0.5)\r\n"]
[24.64826, "o", "\u001b[?2004h"]
[24.648283, "o", "00:30:14Z root@sdfrome046:w13# "]
[28.908165, "m", "00:30:18Z 4 BEFORE: daq_sim e2e at P 5eb773c84b9d (--keep-up), read-back during the run"]
