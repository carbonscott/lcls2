[18.697546, "o", "679ceb644 2026-11-09T21:22:13-08:00 sim: the counts after Disable ask a Prometheus exporter that does not answer again\r\n\r\n"]
[18.69776, "o", "\u001b[1mdiff --git a/psdaq/psdaq/sim/daq_sim.py b/psdaq/psdaq/sim/daq_sim.py\u001b[m\r\n\u001b[1m--- a/psdaq/psdaq/sim/daq_sim.py\u001b[m\r\n\u001b[1m+++ b/psdaq/psdaq/sim/daq_sim.py\u001b[m\r\n\u001b[36m@@ -1772,9 +1772,13 @@\u001b[m\r\n"]
[18.697785, "o", "\u001b[31m-def scrape(port, names, host='127.0.0.1'):\u001b[m\r\n\u001b[31m-    \"\"\"{metric{labels}: value} for metric names in 'names', from host:port.\"\"\"\u001b[m\r\n\u001b[32m+def scrape(port, names, host='127.0.0.1', errors=None):\u001b[m\r\n\u001b[32m+    \"\"\"{metric{labels}: value} for metric names in 'names', from host:port; {} when the exporter\u001b[m\r\n"]
[18.697811, "o", "\u001b[32m+    does not answer in 3 s, and then why is appended to 'errors' (a list), if given.\"\"\"\u001b[m\r\n\u001b[32m+    import http.client\u001b[m\r\n     import urllib.request\u001b[m\r\n     opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))\u001b[m\r\n     out = {}\u001b[m\r\n"]
[18.697841, "o", "     try:\u001b[m"]
[18.697865, "o", "\r\n         text = opener.open(f'http://{host}:{port}/metrics', timeout=3).read().decode()\u001b[m\r\n\u001b[31m-    except OSError:\u001b[m\r\n\u001b[32m+    except (OSError, http.client.HTTPException) as e:\u001b[m\r\n"]
[18.697889, "o", "\u001b[32m+        if errors is not None:\u001b[m\r\n\u001b[32m+            errors.append(f'{type(e).__name__}: {getattr(e, \"reason\", None) or e}')\u001b[m\r\n         return out\u001b[m\r\n"]
[18.69911, "o", "\u001b[?2004h00:30:08Z root@sdfrome046:w13# "]
