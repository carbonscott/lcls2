[14.870959, "o", "\u001b[36m@@ -1298,7 +1384,9 @@\u001b[m\r\n def prometheus_targets(promdir):\u001b[m\r\n\u001b[31m-    out = []\u001b[m\r\n"]
[14.870988, "o", "\u001b[32m+    \"\"\"[(host, port)] of the exporters the DAQ's processes wrote in promdir (<host>:<port> in each yaml);\u001b[m\r\n\u001b[32m+    the host is 127.0.0.1 for this host (up --hosts: a DRP on the other host exports there).\"\"\"\u001b[m\r\n\u001b[32m+    out, here = [], {socket.gethostname(), socket.gethostname().split('.')[0], 'localhost'}\u001b[m\r\n     for name in sorted(os.listdir(promdir)) if os.path.isdir(promdir) else []:\u001b[m\r\n         if name.endswith('.yaml'):\u001b[m\r\n"]
[14.871017, "o", "\u001b[31m-            m = re.search(r\":(\\d+)'\", open(os.path.join(promdir, name)).read())\u001b[m\r\n\u001b[32m+            m = re.search(r\"([^'\\s:]*):(\\d+)'\", open(os.path.join(promdir, name)).read())\u001b[m\r\n"]
[14.871045, "o", "             if m:\u001b[m\r\n\u001b[31m-                out.append(int(m.group(1)))\u001b[m\r\n\u001b[32m+                out.append(('127.0.0.1' if not m.group(1) or m.group(1) in here else m.group(1), int(m.group(2))))\u001b[m\r\n"]
